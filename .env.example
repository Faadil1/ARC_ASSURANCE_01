# Public endpoints are safe to commit as examples.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Arc network parameters, asserted by script/DeployT0.s.sol.
# Native USDC is 18 decimals. The USDC ERC-20 interface is 6 decimals.
# These are the SAME balance; never mix the two representations.
ARC_MAINNET_CHAIN_ID=5042
ARC_TESTNET_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# NEVER COMMIT A REAL PRIVATE KEY.
PRIVATE_KEY=

# Deployment.
# T0_AUTHORITY_ADDRESS must equal the deployer account, because policy
# registration is authority-only and happens in the same broadcast.
T0_AUTHORITY_ADDRESS=
# For the protected T0 proof, funder must equal the PRIVATE_KEY/authority address.
T0_FUNDER_ADDRESS=

# Policy configuration.
T0_POLICY_ID=
T0_PAYOUT_RECIPIENT_ADDRESS=
T0_FUND_AMOUNT_WEI=
T0_UNIT_PAYOUT_WEI=
# Required for T0: non-zero unix timestamp in the future.
# It provides a fail-closed recovery path if payout cannot complete.
T0_EXPIRY=

# Read back from the deploy output before running the value-movement leg.
T0_CONTRACT_ADDRESS=

# Must be exactly 1 before any mainnet value movement. Anything else aborts.
# The driver additionally requires a literal --confirm flag.
T0_CONFIRM_MAINNET=0
