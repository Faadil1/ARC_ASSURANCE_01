# Public endpoints are safe to commit as examples.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# NEVER COMMIT A REAL PRIVATE KEY.
PRIVATE_KEY=

# Fill only after deployment.
T0_CONTRACT_ADDRESS=
T0_RECIPIENT_ADDRESS=

# Native Arc USDC uses 18 decimals for msg.value/native balance.
# Example only; choose deliberately small real-mainnet values.
T0_FUND_AMOUNT_WEI=
T0_PAYOUT_AMOUNT_WEI=
