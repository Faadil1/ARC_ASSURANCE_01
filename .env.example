# Provider service
PORT=8787

# Fault injection must remain disabled in ordinary runtime.
# Enable only for an explicitly disclosed demo/failure scenario.
ALLOW_DEMO_FAULTS=false

# EIP-712 provider-output signing.
# This key is NOT the T0 funder/deployer key and should not hold application funds.
# Use a dedicated provider signer. Never commit the real key.
PROVIDER_SIGNING_KEY=
PROVIDER_CHAIN_ID=5042

# Must be the deployed assurance contract that will verify the signature.
# Domain separation binds the signature to this exact contract address.
PROVIDER_VERIFYING_CONTRACT=
